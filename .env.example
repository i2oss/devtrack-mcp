# Base URL of the DevTrack REST API (no trailing slash).
# Defaults to TechExcel's public trydevsuite sandbox if unset.
DEVTRACK_BASE_URL=http://trydevsuite.techexcel.com/DevTrackAPI

# User token generated by a DevTrack admin (Admin > Manage Users > API Token,
# or via the LinkPlus web service). Required for any real instance; the
# sandbox may work read-only without one for some endpoints.
DEVTRACK_TOKEN=

# Optional: 1 = English, 2 = Chinese, 3 = Japanese. Defaults to 1.
DEVTRACK_LANGUAGE_ID=1
